---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CenterCard from '@/components/CenterCard.astro';
import FinalCta from '@/components/FinalCta.astro';
import Icon from '@/components/Icon.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { centers } from '@/data/centers';
import { publishedProducts } from '@/data/products';
import type { Product } from '@/data/types';
import { sanitizeConversionText, type NaverConversion } from '@/data/tracking';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { absoluteUrl } from '@/lib/paths';

export function getStaticPaths() {
  return publishedProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const modelLabel = product.officialModel ?? '공식 모델 코드 미표기';
const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '제품 라인업', href: '/products/' },
  { name: product.name, href: `/products/${product.slug}/` },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  model: product.officialModel ?? undefined,
  category: product.productType,
  description: product.summary,
  image: absoluteUrl(product.mainImage.webp ?? product.mainImage.src),
  brand: { '@type': 'Brand', name: '3H' },
  url: absoluteUrl(`/products/${product.slug}/`),
  offers: product.officialPriceKrw ? {
    '@type': 'Offer',
    priceCurrency: 'KRW',
    price: product.officialPriceKrw,
    url: product.officialProductUrl,
  } : undefined,
};
// 네이버 전환: 상품상세보기(view_product)
const naverConversion: NaverConversion = {
  type: 'view_product',
  id: String(product.officialId),
  items: [
    {
      id: String(product.officialId),
      name: sanitizeConversionText(product.name),
      category: sanitizeConversionText(product.officialCategory),
      quantity: 1,
      payAmount: product.officialPriceKrw ?? 0,
      option: sanitizeConversionText(product.officialModel ?? ''),
    },
  ],
};
---

<BaseLayout
  title={`${product.name}${product.officialModel ? ` ${product.officialModel}` : ''}`}
  description={`${product.name}${product.officialModel ? `(${product.officialModel})` : ''} 공식 가격·사진·상세 정보와 진주센터 체험 문의 안내입니다.`}
  image={product.mainImage.webp ?? product.mainImage.src}
  breadcrumbs={breadcrumbs}
  schema={schema}
  pageEvent="product_view"
  product={product.slug}
  naverConversion={naverConversion}
>
  <Breadcrumbs items={breadcrumbs} />
  <section class="product-hero">
    <div class="container-wide product-hero-grid">
      <div class="product-visual"><ResponsiveImage image={product.mainImage} class="main-image" loading="eager" fetchpriority="high" sizes="(max-width: 800px) 100vw, 55vw" /></div>
      <div class="product-copy">
        <p class="section-kicker">{product.officialCategory} · OFFICIAL CATALOG</p>
        <h1>{product.name}</h1>
        <p class="model">{modelLabel}</p>
        <p class="price">{product.officialPriceText ?? '공식 홈페이지 가격 미표기'}</p>
        <p class="description">{product.summary}</p>
        <div class="tags">{product.categories.map((category) => <span>{category}</span>)}</div>
        <div class="product-actions">
          <a class="button-primary" href="#centers" data-track-event="product_center_click" data-product={product.slug}>센터 체험 문의 <Icon name="arrow" size={18} /></a>
          <a class="button-ghost" href={product.officialProductUrl} target="_blank" rel="noopener noreferrer">본사 공식 제품 페이지 <Icon name="external" size={17} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space facts-section">
    <div class="container-wide facts-grid">
      <div><p class="section-kicker">OFFICIAL PRODUCT DATA</p><h2 class="section-title">공식 카탈로그 정보를 정리했습니다</h2></div>
      <dl>
        <div><dt>제품명</dt><dd>{product.name}</dd></div>
        <div><dt>공식 모델명</dt><dd>{modelLabel}</dd></div>
        <div><dt>공식 카테고리</dt><dd>{product.officialCategory}</dd></div>
        <div><dt>제품 유형</dt><dd>{product.productType}</dd></div>
        <div><dt>공식 표시 가격</dt><dd>{product.officialPriceText ?? '공식 홈페이지에 가격이 게시되지 않았습니다.'}</dd></div>
        <div><dt>렌탈 표시</dt><dd>{product.rentalConsultationAvailable ? '공식 목록에 렌탈 가능 표시' : '공식 목록에 렌탈 표시 없음'}</dd></div>
        <div><dt>상세 이미지</dt><dd>{product.gallery.length}장</dd></div>
        <div><dt>정보 확인일</dt><dd><time datetime={product.priceCheckedAt}>{product.priceCheckedAt}</time></dd></div>
      </dl>
    </div>
    <div class="container-wide scope-notice">
      <strong>공식 자료 기준</strong>
      <p>가격·모델·사진은 3H 공식 제품 페이지 기준입니다. 의료기기 해당 여부, 사용 목적·방법·주의사항은 제품별 공식 상세자료와 사용설명서를 따르며 센터 판매 조건은 상담 시 안내합니다.</p>
      <a href={product.officialProductUrl} target="_blank" rel="noopener noreferrer">공식 원문 열기 <Icon name="external" size={17} /></a>
    </div>
  </section>

  <section class="section-space detail-section">
    <div class="container-wide detail-container">
      <SectionHeading kicker="OFFICIAL DETAIL IMAGES" title={`${product.name} 상세 정보`} description="3H 공식 제품 상세페이지에 게시된 이미지 자료를 웹용으로 최적화해 순서대로 제공합니다." />
      <div class="product-gallery">
        {product.gallery.map((image) => <ResponsiveImage image={image} class="detail-image" sizes="(max-width: 1200px) 100vw, 1100px" />)}
      </div>
    </div>
  </section>

  <section class="section-space centers-section" id="centers">
    <div class="container-wide">
      <div class="centers-heading"><p class="section-kicker">CENTER EXPERIENCE</p><h2 class="section-title">희망 모델로 무료체험을 문의하세요</h2><p>제품명과 방문 희망 센터를 알려주시면 체험 모델과 상담 일정을 안내합니다.</p></div>
      <div class="center-grid">{centers.map((center) => <CenterCard center={center} />)}</div>
    </div>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .product-hero {
    padding-block: clamp(3rem, 8vw, 7rem);
    background: #eee3d1;
  }

  .product-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .product-visual {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: white;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.65rem, 6vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .model {
    margin: 0.75rem 0 0;
    color: #8f6835;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 800;
  }

  .price {
    margin: .5rem 0 0;
    color: #174b35;
    font-size: clamp(1.45rem, 3vw, 2.2rem);
    font-weight: 850;
  }

  .description {
    margin: 1.5rem 0;
    color: #5c5448;
    font-size: 1.05rem;
  }

  .tags,
  .product-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tags span {
    padding: 0.3rem 0.6rem;
    border: 1px solid #cabca7;
    font-size: 0.78rem;
  }

  .product-actions {
    margin-top: 2rem;
  }

  .facts-section {
    background: white;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: minmax(16rem, .65fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  dl {
    margin: 0;
    border-top: 1px solid #9ba29e;
  }

  dl > div {
    display: grid;
    grid-template-columns: minmax(8rem, .45fr) minmax(0, 1.55fr);
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid #d5d8d5;
  }

  dt {
    color: #707773;
  }

  dd {
    margin: 0;
    font-weight: 650;
  }

  .scope-notice {
    display: grid;
    grid-template-columns: minmax(10rem, .35fr) minmax(0, 1.35fr) auto;
    gap: 2rem;
    margin-top: 3rem;
    padding: 1.5rem;
    border-left: 4px solid #8f6835;
    background: #f0f1ef;
  }

  .scope-notice p,
  .centers-heading > p:last-child {
    margin: 0;
    color: #5b625f;
  }

  .scope-notice a {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: .4rem;
    color: #174b35;
    font-weight: 800;
  }

  .detail-section {
    background: #f0f1ef;
  }

  .detail-container {
    max-width: 72rem;
  }

  .product-gallery {
    display: grid;
    margin-top: 3rem;
    overflow: hidden;
    background: white;
  }

  .detail-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .centers-section {
    background: #f0f1ef;
  }

  .centers-heading {
    max-width: 48rem;
  }

  .center-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }

  @media (max-width: 800px) {
    .product-hero-grid,
    .facts-grid,
    .scope-notice,
    .center-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .product-actions {
      display: grid;
    }

    dl > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
