---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CenterCard from '@/components/CenterCard.astro';
import FinalCta from '@/components/FinalCta.astro';
import Icon from '@/components/Icon.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { centers } from '@/data/centers';
import { publishedProducts } from '@/data/products';
import type { Product } from '@/data/types';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { absoluteUrl } from '@/lib/paths';

export function getStaticPaths() {
  return publishedProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '제품 라인업', href: '/products/' },
  { name: product.name, href: `/products/${product.slug}/` },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  model: product.officialModel,
  category: product.productType,
  description: product.summary,
  image: absoluteUrl(product.mainImage.webp ?? product.mainImage.src),
  brand: { '@type': 'Brand', name: '3H' },
  url: absoluteUrl(`/products/${product.slug}/`),
};
---

<BaseLayout
  title={`${product.name} ${product.officialModel}`}
  description={`${product.name}(${product.officialModel}) 공식 제품 정보와 진주센터 체험 문의 안내입니다.`}
  image={product.mainImage.webp ?? product.mainImage.src}
  breadcrumbs={breadcrumbs}
  schema={schema}
  pageEvent="product_view"
  product={product.slug}
>
  <Breadcrumbs items={breadcrumbs} />
  <section class="product-hero">
    <div class="container-wide product-hero-grid">
      <div class="product-visual"><ResponsiveImage image={product.mainImage} class="main-image" loading="eager" fetchpriority="high" sizes="(max-width: 800px) 100vw, 55vw" /></div>
      <div class="product-copy">
        <p class="section-kicker">{product.productType} · OFFICIAL MODEL</p>
        <h1>{product.name}</h1>
        <p class="model">{product.officialModel}</p>
        <p class="description">{product.summary}</p>
        <div class="tags">{product.categories.map((category) => <span>{category}</span>)}</div>
        <div class="product-actions">
          <a class="button-primary" href="#centers" data-track-event="product_center_click" data-product={product.slug}>센터 체험 문의 <Icon name="arrow" size={18} /></a>
          <a class="button-ghost" href={product.officialProductUrl} target="_blank" rel="noopener noreferrer">본사 공식 제품 페이지 <Icon name="external" size={17} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space facts-section">
    <div class="container-wide facts-grid">
      <div><p class="section-kicker">VERIFIED DATA</p><h2 class="section-title">확인된 정보만 표시합니다</h2></div>
      <dl>
        <div><dt>제품명</dt><dd>{product.name}</dd></div>
        <div><dt>공식 모델명</dt><dd>{product.officialModel}</dd></div>
        <div><dt>제품 유형</dt><dd>{product.productType}</dd></div>
        <div><dt>가격</dt><dd>센터에서 최신 정보 확인</dd></div>
        <div><dt>의료기기 인증</dt><dd>해당 모델의 공식 품목 인증 범위와 인증서를 상담 시 안내합니다.</dd></div>
        <div><dt>사용 목적·방법·주의사항</dt><dd>제품별 공식 설명서에 따라 사용 방법과 주의사항을 안내합니다.</dd></div>
      </dl>
    </div>
    <div class="container-wide scope-notice">
      <strong>인증 적용 범위 안내</strong>
      <p>제인 19-4214호 인증은 인증서에 기재된 개인용 온열기 품목과 모델 3H22M-1에 관한 자료입니다. 현재 보고 계신 제품에 적용된다고 확인되지 않아 이 페이지의 제품 인증으로 표시하지 않습니다.</p>
    </div>
  </section>

  <section class="section-space centers-section" id="centers">
    <div class="container-wide">
      <div class="centers-heading"><p class="section-kicker">CENTER EXPERIENCE</p><h2 class="section-title">희망 모델로 무료체험을 문의하세요</h2><p>제품명과 방문 희망 센터를 알려주시면 체험 모델과 상담 일정을 안내합니다.</p></div>
      <div class="center-grid">{centers.map((center) => <CenterCard center={center} />)}</div>
    </div>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .product-hero {
    padding-block: clamp(3rem, 8vw, 7rem);
    background: #eee3d1;
  }

  .product-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .product-visual {
    overflow: hidden;
    background: white;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.65rem, 6vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .model {
    margin: 0.75rem 0 0;
    color: #8f6835;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 800;
  }

  .description {
    margin: 1.5rem 0;
    color: #5c5448;
    font-size: 1.05rem;
  }

  .tags,
  .product-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tags span {
    padding: 0.3rem 0.6rem;
    border: 1px solid #cabca7;
    font-size: 0.78rem;
  }

  .product-actions {
    margin-top: 2rem;
  }

  .facts-section {
    background: white;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: minmax(16rem, .65fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  dl {
    margin: 0;
    border-top: 1px solid #9ba29e;
  }

  dl > div {
    display: grid;
    grid-template-columns: minmax(8rem, .45fr) minmax(0, 1.55fr);
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid #d5d8d5;
  }

  dt {
    color: #707773;
  }

  dd {
    margin: 0;
    font-weight: 650;
  }

  .scope-notice {
    display: grid;
    grid-template-columns: minmax(12rem, .4fr) minmax(0, 1.6fr);
    gap: 2rem;
    margin-top: 3rem;
    padding: 1.5rem;
    border-left: 4px solid #8f6835;
    background: #f0f1ef;
  }

  .scope-notice p,
  .centers-heading > p:last-child {
    margin: 0;
    color: #5b625f;
  }

  .centers-section {
    background: #f0f1ef;
  }

  .centers-heading {
    max-width: 48rem;
  }

  .center-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }

  @media (max-width: 800px) {
    .product-hero-grid,
    .facts-grid,
    .scope-notice,
    .center-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .product-actions {
      display: grid;
    }

    dl > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
