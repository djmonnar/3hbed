---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FinalCta from '@/components/FinalCta.astro';
import PageHero from '@/components/PageHero.astro';
import ProductCard from '@/components/ProductCard.astro';
import { productCatalog, publishedProducts } from '@/data/products';
import BaseLayout from '@/layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '제품 라인업', href: '/products/' },
];
const categories = ['전체', '3H지압침대', '의료기기&건강보조기기', '건강 · 미용용품', '렌탈 가능', '1인용', '2인용'];
---

<BaseLayout
  title="3H지압침대 제품 라인업"
  description="3H 공식 홈페이지의 전체 45개 제품과 가격, 모델, 상세 이미지를 확인하고 진주센터 무료체험을 문의하세요."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />
  <PageHero kicker="OFFICIAL PRODUCT CATALOG" title="3H 공식 제품 45개를 한곳에서 살펴보세요" description={`지압침대부터 의료기기·건강보조기기와 건강·미용용품까지 ${productCatalog.checkedAt} 공식 카탈로그를 반영했습니다.`} />

  <section class="section-space product-listing">
    <div class="container-wide">
      <div class="filters" role="group" aria-label="제품 분류">
        {categories.map((category, index) => <button type="button" data-product-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}
      </div>
      <div class="catalog-status"><strong>전체 {productCatalog.total}개 제품</strong><span data-product-count aria-live="polite">{publishedProducts.length}개 표시 중</span></div>
      <div class="product-grid" aria-live="polite">
        {publishedProducts.map((product) => (
          <div data-product-item data-categories={product.categories.join('|')}><ProductCard product={product} /></div>
        ))}
      </div>
      <div class="product-notice">
        <strong>가격·체험 안내</strong>
        <p>가격은 {productCatalog.checkedAt} 공식 홈페이지 표시 기준이며, 가격이 없는 제품은 공식 페이지에 금액이 게시되지 않은 항목입니다. 센터 판매 조건과 체험 가능 모델은 상담 시 안내합니다.</p>
      </div>
    </div>
  </section>
  <FinalCta />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-product-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-product-item]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.productFilter || '전체';
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      items.forEach((item) => {
        const categories = (item.dataset.categories || '').split('|');
        item.hidden = selected !== '전체' && !categories.includes(selected);
      });
      const visibleCount = [...items].filter((item) => !item.hidden).length;
      const count = document.querySelector<HTMLElement>('[data-product-count]');
      if (count) count.textContent = `${visibleCount}개 표시 중`;
    });
  });
</script>

<style>
  .product-listing {
    background: white;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #d5d8d5;
  }

  .filters button {
    min-height: 48px;
    padding: 0.55rem 1rem;
    border: 1px solid #b9bfbb;
    background: transparent;
    color: #4a514e;
    cursor: pointer;
    font-weight: 700;
  }

  .filters button[aria-pressed='true'] {
    border-color: #174b35;
    background: #174b35;
    color: white;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 3rem;
  }

  .catalog-status {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    color: #5b625f;
    font-size: .88rem;
  }

  .catalog-status strong {
    color: #174b35;
  }

  .product-grid > div[hidden] {
    display: none;
  }

  .product-notice {
    display: grid;
    grid-template-columns: minmax(10rem, .4fr) minmax(0, 1.6fr);
    gap: 2rem;
    margin-top: 4rem;
    padding: 1.5rem;
    border-left: 4px solid #8f6835;
    background: #f0f1ef;
  }

  .product-notice p {
    margin: 0;
    color: #5b625f;
  }

  @media (max-width: 860px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .product-grid,
    .product-notice {
      grid-template-columns: 1fr;
    }
  }
</style>
