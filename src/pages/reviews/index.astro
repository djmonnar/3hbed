---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FinalCta from '@/components/FinalCta.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { centers } from '@/data/centers';
import { visitorProfiles } from '@/data/reviews';
import BaseLayout from '@/layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '고객후기', href: '/reviews/' },
];
const reviewCheckedAt = '2026년 7월 10일';
---

<BaseLayout
  title="3H지압침대 진주센터 고객후기"
  description="출처와 사용 동의가 확인된 실제 후기만 제공하는 3H지압침대 진주센터 후기 안내입니다."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />
  <PageHero kicker="NAVER REVIEWS" title="두 센터의 실제 후기를 네이버에서 확인하세요" description="센터별 네이버 플레이스에 등록된 방문자·블로그 리뷰 수와 원문 링크를 바로 제공합니다." />

  <section class="section-space profiles-section">
    <div class="container-wide profiles-grid">
      <SectionHeading kicker="WHO VISITS" title="이런 분들이 체험을 고려합니다" description="제품을 온라인에서 바로 결정하기 어려운 이유를 중심으로 방문 상황을 정리했습니다." />
      <ol>{visitorProfiles.map((profile, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{profile}</li>)}</ol>
    </div>
  </section>

  <section class="section-space review-section">
    <div class="container-wide">
      <SectionHeading kicker="CUSTOMER STORIES" title="네이버 플레이스 후기 현황" description={`${reviewCheckedAt} 네이버 플레이스에서 확인한 수치이며, 새 후기가 등록되면 달라질 수 있습니다.`} />
      <div class="review-grid">
        {centers.map((center) => (
          <article>
            <p class="review-label">{center.naverReviewLabel}</p>
            <strong><span>{center.naverReviewCount}</span>건</strong>
            <h3>{center.name}</h3>
            <p>작성자가 공개한 후기 내용과 사진은 네이버 플레이스 원문에서 확인할 수 있습니다.</p>
            <a href={center.naverPlaceUrl} target="_blank" rel="noopener noreferrer" data-track-event="place_click" data-center={center.id}>실제 후기 보기 <Icon name="external" size={17} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="standards-section">
    <div class="container-wide standards-grid">
      <div><p class="section-kicker">PUBLISHING STANDARD</p><h2>후기 등록 기준</h2></div>
      <ul><li>실제 작성자가 확인되는 후기</li><li>원문 URL 또는 출처 보관</li><li>이름·연락처 등 개인정보 마스킹</li><li>홈페이지 사용 동의 확인</li><li>제품·센터 정보 사실 확인</li><li>의미를 바꾸는 과장 편집 금지</li></ul>
    </div>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .profiles-section {
    background: white;
  }

  .profiles-grid {
    display: grid;
    grid-template-columns: minmax(18rem, .7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid #9ba29e;
    list-style: none;
  }

  ol li {
    display: grid;
    min-height: 68px;
    grid-template-columns: 3rem 1fr;
    align-items: center;
    border-bottom: 1px solid #d5d8d5;
    font-weight: 680;
  }

  ol span {
    color: #8f6835;
    font-size: 0.72rem;
  }

  .review-section {
    background: #f0f1ef;
  }

  .review-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  .review-grid article {
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-top: 3px solid #174b35;
    background: white;
  }

  .review-grid .review-label {
    margin: 0;
    color: #8f6835;
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .review-grid article > strong {
    display: block;
    margin-top: .4rem;
    color: #174b35;
    font-size: 1.15rem;
  }

  .review-grid article > strong span {
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 1;
  }

  .review-grid h3 {
    margin: 1.5rem 0 .5rem;
    font-size: 1.45rem;
  }

  .review-grid article > p:not(.review-label) {
    color: #5b625f;
  }

  .review-grid a {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: .45rem;
    margin-top: .75rem;
    color: #174b35;
    font-weight: 800;
  }

  .standards-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: #123d2d;
    color: white;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: minmax(16rem, .7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .standards-grid .section-kicker {
    color: #d4b47c;
  }

  .standards-grid h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .standards-grid ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255,255,255,.35);
    list-style: none;
  }

  .standards-grid li {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255,255,255,.2);
    color: #dce9e1;
  }

  @media (max-width: 760px) {
    .profiles-grid,
    .standards-grid,
    .review-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .standards-grid ul {
      grid-template-columns: 1fr;
    }
  }
</style>
