---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FinalCta from '@/components/FinalCta.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { publishedReviews, visitorProfiles } from '@/data/reviews';
import BaseLayout from '@/layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '고객후기', href: '/reviews/' },
];
---

<BaseLayout
  title="3H지압침대 진주센터 고객후기"
  description="출처와 사용 동의가 확인된 실제 후기만 제공하는 3H지압침대 진주센터 후기 안내입니다."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />
  <PageHero kicker="VERIFIED REVIEWS" title="실제 후기만, 출처와 동의를 확인한 뒤 공개합니다" description="후기를 꾸며내거나 출처 없는 별점을 표시하지 않습니다. 현재 공개 기준을 충족한 후기가 없어 체험 고객 유형을 안내합니다." />

  <section class="section-space profiles-section">
    <div class="container-wide profiles-grid">
      <SectionHeading kicker="WHO VISITS" title="이런 분들이 체험을 고려합니다" description="제품을 온라인에서 바로 결정하기 어려운 이유를 중심으로 방문 상황을 정리했습니다." />
      <ol>{visitorProfiles.map((profile, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{profile}</li>)}</ol>
    </div>
  </section>

  <section class="section-space review-section">
    <div class="container-wide">
      <SectionHeading kicker="CUSTOMER STORIES" title="공개된 실제 후기" />
      {publishedReviews.length ? (
        <div class="review-grid">
          {publishedReviews.map((review) => <article><p>{review.content}</p><footer><strong>{review.displayName}</strong><span>{review.createdAt} · {review.source}</span></footer></article>)}
        </div>
      ) : (
        <div class="empty-state">
          <strong>공개 기준을 충족한 후기를 준비 중입니다.</strong>
          <p>표시명, 작성일, 원문 URL, 개인정보 마스킹 여부, 홈페이지 사용 동의가 모두 확인된 후기만 이 영역에 등록합니다.</p>
        </div>
      )}
    </div>
  </section>

  <section class="standards-section">
    <div class="container-wide standards-grid">
      <div><p class="section-kicker">PUBLISHING STANDARD</p><h2>후기 등록 기준</h2></div>
      <ul><li>실제 작성자가 확인되는 후기</li><li>원문 URL 또는 출처 보관</li><li>이름·연락처 등 개인정보 마스킹</li><li>홈페이지 사용 동의 확인</li><li>제품·센터 정보 사실 확인</li><li>의미를 바꾸는 과장 편집 금지</li></ul>
    </div>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .profiles-section {
    background: white;
  }

  .profiles-grid {
    display: grid;
    grid-template-columns: minmax(18rem, .7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid #9ba29e;
    list-style: none;
  }

  ol li {
    display: grid;
    min-height: 68px;
    grid-template-columns: 3rem 1fr;
    align-items: center;
    border-bottom: 1px solid #d5d8d5;
    font-weight: 680;
  }

  ol span {
    color: #8f6835;
    font-size: 0.72rem;
  }

  .review-section {
    background: #f0f1ef;
  }

  .empty-state {
    margin-top: 3rem;
    padding: clamp(2rem, 6vw, 5rem);
    border-top: 3px solid #174b35;
    background: white;
    text-align: center;
  }

  .empty-state strong {
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .empty-state p {
    max-width: 42rem;
    margin: 1rem auto 0;
    color: #5b625f;
  }

  .review-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  .standards-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: #123d2d;
    color: white;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: minmax(16rem, .7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .standards-grid .section-kicker {
    color: #d4b47c;
  }

  .standards-grid h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .standards-grid ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255,255,255,.35);
    list-style: none;
  }

  .standards-grid li {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255,255,255,.2);
    color: #dce9e1;
  }

  @media (max-width: 760px) {
    .profiles-grid,
    .standards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .standards-grid ul {
      grid-template-columns: 1fr;
    }
  }
</style>
