---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FinalCta from '@/components/FinalCta.astro';
import Icon from '@/components/Icon.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { centers } from '@/data/centers';
import { site } from '@/data/site';
import type { Center } from '@/data/types';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { absoluteUrl, phoneHref, smsHref } from '@/lib/paths';

export function getStaticPaths() {
  return centers.filter((center) => center.isPublished).map((center) => ({ params: { slug: center.slug }, props: { center } }));
}

interface Props {
  center: Center;
}

const { center } = Astro.props;
const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '진주센터', href: '/centers/' },
  { name: center.shortName, href: `/centers/${center.slug}/` },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: center.name,
  url: absoluteUrl(`/centers/${center.slug}/`),
  telephone: center.phone,
  openingHours: center.openingHoursSchema,
  address: { '@type': 'PostalAddress', streetAddress: center.address, addressLocality: '진주시', addressRegion: '경상남도', addressCountry: 'KR' },
  sameAs: [center.naverPlaceUrl],
  parentOrganization: { '@type': 'Organization', name: site.name, url: absoluteUrl('/') },
};
---

<BaseLayout
  title={`${center.name} 무료체험`}
  description={`${center.name}의 위치와 3H지압침대 무료체험, 전화·문자·네이버 플레이스 안내입니다.`}
  breadcrumbs={breadcrumbs}
  schema={schema}
  naverConversion={{ type: 'view_content', id: `center_${center.slug}` }}
>
  <Breadcrumbs items={breadcrumbs} />
  <section class="center-hero">
    <div class="container-wide hero-grid">
      <div class="hero-copy">
        <p class="section-kicker">3H JINJU CENTER</p>
        <h1>{center.name}</h1>
        <p>{center.address}</p>
        <div class="actions">
          <a class="button-primary" href={phoneHref(center.phone)} data-track-event="phone_click" data-center={center.id}><Icon name="phone" size={20} /> 무료체험 문의</a>
          {center.sms && <a class="button-secondary" href={smsHref(center.sms, `${center.shortName} 무료체험 문의드립니다.`)} data-track-event="sms_click" data-center={center.id}><Icon name="message" size={20} /> 문자 문의</a>}
          <a class="button-ghost" href={center.naverPlaceUrl} target="_blank" rel="noopener noreferrer" data-track-event="place_click" data-center={center.id}><Icon name="map" size={20} /> 네이버 길찾기</a>
        </div>
      </div>
      <div class="hero-media">
        <ResponsiveImage image={center.heroImage} class="center-image" loading="eager" fetchpriority="high" sizes="(max-width: 820px) 100vw, 58vw" />
      </div>
    </div>
  </section>

  <section class="section-space info-section">
    <div class="container-wide info-grid">
      <SectionHeading kicker="VISIT INFORMATION" title="센터 방문 정보" description="운영시간과 휴무일을 확인하고 무료체험을 예약하세요." />
      <dl>
        <div><dt>주소</dt><dd>{center.address}</dd></div>
        <div><dt>전화</dt><dd>{center.phone}</dd></div>
        <div><dt>운영시간</dt><dd>{center.openingHours}</dd></div>
        <div><dt>휴무일</dt><dd>{center.closedDays}</dd></div>
        <div><dt>주차</dt><dd>{center.parking}</dd></div>
        <div><dt>찾아오는 길</dt><dd>{center.directions}</dd></div>
        <div><dt>편의시설</dt><dd>{center.amenities.join(' · ')}</dd></div>
        <div><dt>체험 품목</dt><dd>{center.experienceProducts.join(', ')}</dd></div>
        <div><dt>네이버 후기</dt><dd><a href={center.naverPlaceUrl} target="_blank" rel="noopener noreferrer">{center.naverReviewLabel} {center.naverReviewCount}건 보기</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="section-space gallery-section">
    <div class="container-wide">
      <SectionHeading kicker="CENTER GALLERY" title="센터 내부를 미리 살펴보세요" description="실제 진주센터에서 촬영한 체험 공간과 전시 제품 사진입니다." />
      <div class="gallery-grid">
        {center.gallery.map((image) => <ResponsiveImage image={image} class="gallery-image" sizes="(max-width: 540px) 100vw, 50vw" />)}
      </div>
    </div>
  </section>

  <section class="location-notice">
    <div class="container-wide"><strong>길찾기와 예약</strong><p>네이버 플레이스에서 실시간 길찾기와 무료체험 예약 정보를 확인하세요.</p><a href={center.naverPlaceUrl} target="_blank" rel="noopener noreferrer" data-track-event="place_click" data-center={center.id}>네이버 플레이스 열기 <Icon name="external" size={17} /></a></div>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .center-hero {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: #eee3d1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(18rem, .8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.7rem, 6vw, 5.4rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .hero-copy > p:not(.section-kicker) {
    margin: 1.5rem 0;
    color: #5c5448;
    font-size: 1.05rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .hero-media {
    min-width: 0;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .center-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info-section {
    background: white;
  }

  .info-grid {
    display: grid;
    grid-template-columns: minmax(16rem, .6fr) minmax(0, 1.4fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  dl {
    margin: 0;
    border-top: 1px solid #9ba29e;
  }

  dl > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid #d5d8d5;
  }

  dt {
    color: #707773;
  }

  dd {
    margin: 0;
    font-weight: 650;
  }

  .gallery-section {
    background: #f0f1ef;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
    margin-top: 3rem;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .location-notice {
    padding-block: 2rem;
    background: #123d2d;
    color: white;
  }

  .location-notice > div {
    display: grid;
    grid-template-columns: .5fr 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .location-notice p {
    margin: 0;
    color: #dce9e1;
  }

  .location-notice a {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0.4rem;
    color: #e2c796;
    font-weight: 750;
  }

  @media (max-width: 820px) {
    .hero-grid,
    .info-grid,
    .location-notice > div {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 540px) {
    .actions,
    .gallery-grid {
      display: grid;
      grid-template-columns: 1fr;
    }

    dl > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
