---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CenterCard from '@/components/CenterCard.astro';
import FinalCta from '@/components/FinalCta.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { centers } from '@/data/centers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { absoluteUrl } from '@/lib/paths';

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '진주센터', href: '/centers/' },
];
const schema = centers.map((center) => ({
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: center.name,
  url: absoluteUrl(`/centers/${center.slug}/`),
  telephone: center.phone,
  openingHours: center.openingHoursSchema,
  address: { '@type': 'PostalAddress', streetAddress: center.address, addressLocality: '진주시', addressRegion: '경상남도', addressCountry: 'KR' },
  sameAs: center.naverPlaceUrl,
}));
---

<BaseLayout
  title="3H지압침대 진주센터"
  description="3H지압침대 진주 남강센터와 진주경상센터의 위치, 무료체험, 전화·문자·네이버 플레이스 안내입니다."
  breadcrumbs={breadcrumbs}
  schema={schema}
  naverConversion={{ type: 'view_content', id: 'center_guide' }}
>
  <Breadcrumbs items={breadcrumbs} />
  <PageHero kicker="TWO CENTERS IN JINJU" title="진주에서 가까운 3H 체험센터를 선택하세요" description="두 센터 모두 지압침대와 지압쇼파를 무료로 체험할 수 있습니다. 위치와 운영시간을 비교한 뒤 편한 센터로 문의하세요." />

  <section class="section-space center-list">
    <div class="container-wide center-grid">{centers.map((center) => <CenterCard center={center} headingLevel="h2" />)}</div>
  </section>

  <section class="section-space compare-section">
    <div class="container-wide compare-grid">
      <SectionHeading kicker="CENTER INFORMATION" title="두 센터 방문 정보를 한눈에 확인하세요" description="네이버 플레이스에서 확인한 주소·전화·운영시간·주차 정보를 센터별로 정리했습니다." />
      <div class="table-wrap">
        <table>
          <thead><tr><th>항목</th>{centers.map((center) => <th>{center.shortName}</th>)}</tr></thead>
          <tbody>
            <tr><th>주소</th>{centers.map((center) => <td>{center.address}</td>)}</tr>
            <tr><th>전화</th>{centers.map((center) => <td>{center.phone}</td>)}</tr>
            <tr><th>무료체험</th>{centers.map((center) => <td>{center.freeExperience ? '전화·네이버 예약' : '상담 문의'}</td>)}</tr>
            <tr><th>운영시간</th>{centers.map((center) => <td>{center.openingHours}<br />{center.closedDays}</td>)}</tr>
            <tr><th>주차</th>{centers.map((center) => <td>{center.parking}</td>)}</tr>
            <tr><th>체험 품목</th>{centers.map((center) => <td>{center.experienceProducts.join(', ')}</td>)}</tr>
            <tr><th>네이버 후기</th>{centers.map((center) => <td><a href={center.naverPlaceUrl} target="_blank" rel="noopener noreferrer">{center.naverReviewLabel} {center.naverReviewCount}건</a></td>)}</tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .center-list {
    background: #f0f1ef;
  }

  .center-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .compare-section {
    background: white;
  }

  .compare-grid {
    display: grid;
    grid-template-columns: minmax(17rem, .6fr) minmax(0, 1.4fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
    text-align: left;
  }

  th,
  td {
    padding: 1rem;
    border-bottom: 1px solid #d5d8d5;
    vertical-align: top;
  }

  thead th {
    border-top: 1px solid #9ba29e;
    background: #f0f1ef;
  }

  tbody th {
    width: 8rem;
    color: #707773;
    font-size: 0.84rem;
  }

  td {
    font-size: 0.9rem;
    font-weight: 620;
  }

  @media (max-width: 800px) {
    .center-grid,
    .compare-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
