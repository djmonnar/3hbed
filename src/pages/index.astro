---
import CenterCard from '@/components/CenterCard.astro';
import CertificationCard from '@/components/CertificationCard.astro';
import ExperienceSteps from '@/components/ExperienceSteps.astro';
import FaqList from '@/components/FaqList.astro';
import FinalCta from '@/components/FinalCta.astro';
import Icon from '@/components/Icon.astro';
import ProductCard from '@/components/ProductCard.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import { centers } from '@/data/centers';
import { publishedCertifications } from '@/data/certifications';
import { publishedFaqs } from '@/data/faqs';
import { featuredProducts, productCatalog } from '@/data/products';
import { heroMedia, site } from '@/data/site';
import { visitorProfiles } from '@/data/reviews';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { phoneHref, smsHref, withBase } from '@/lib/paths';

const schemas = centers.map((center) => ({
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: center.name,
  url: new URL(withBase(`/centers/${center.slug}/`), Astro.site).toString(),
  telephone: center.phone,
  openingHours: center.openingHoursSchema,
  address: { '@type': 'PostalAddress', streetAddress: center.address, addressLocality: '진주시', addressRegion: '경상남도', addressCountry: 'KR' },
  sameAs: [center.naverPlaceUrl],
}));

const stats = [
  { value: '45', unit: '가지', label: '공식 제품' },
  { value: '2', unit: '개', label: '진주 체험센터' },
  { value: '무료', unit: '', label: '체험 가능' },
  { value: '공식', unit: '', label: '인증 대리점' },
];

const experienceFeatures = [
  { icon: 'bed' as const, text: '제품과 모델별 사용감 비교' },
  { icon: 'hand' as const, text: '지압과 온열 기능 직접 확인' },
  { icon: 'check' as const, text: '침대형과 쇼파형 비교' },
  { icon: 'building' as const, text: '집 안 설치 공간 상담' },
  { icon: 'check' as const, text: '1인용과 2인용 크기 비교' },
  { icon: 'message' as const, text: '구매·렌탈 조건 상담' },
  { icon: 'check' as const, text: '실제 사용자와 동반 체험' },
];

const profileIcons = ['phone', 'bed', 'check', 'building', 'shield', 'hand'] as const;
---

<BaseLayout
  title="진주에서 직접 체험하는 3H지압침대"
  description={site.description}
  schema={schemas}
>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="home-hero">
    <div class="container-wide hero-grid">
      <div class="hero-copy">
        <div class="hero-badge">
          <Icon name="shield" size={14} strokeWidth={2} />
          <span>3H 공식 인증 대리점 · 진주</span>
        </div>
        <h1 class="display-title">진주에서<br />직접 체험하는<br /><em>3H지압침대</em></h1>
        <p class="lead-copy">특허받은 62개의 황동 지압봉과 최고 70도 온열 기능. 진주경상센터와 남강센터에서 제품 형태와 크기를 직접 비교하고 무료로 체험해 보세요.</p>
        <div class="hero-actions">
          <a class="button-primary hero-cta-primary" href={withBase('/experience/')} data-track-event="reservation_click">
            무료체험 예약하기 <Icon name="arrow" size={19} />
          </a>
          <a class="button-ghost" href={withBase('/centers/')} data-track-event="center_select">가까운 센터 찾기</a>
        </div>
        <a class="hero-sub-link" href={withBase('/technology/')}>
          3H 기술 자세히 알아보기 <Icon name="arrow" size={16} />
        </a>
      </div>

      <div class="hero-visual" aria-label="진주 3H 체험센터 사진">
        <div class="hero-frame hero-frame-brand">
          <ResponsiveImage image={heroMedia.brand} class="hero-product-image" loading="eager" fetchpriority="high" sizes="(max-width: 960px) 94vw, 43vw" />
        </div>
        <div class="hero-frame hero-frame-showroom">
          <ResponsiveImage image={heroMedia.showroom} class="hero-product-image" loading="eager" sizes="(max-width: 960px) 86vw, 36vw" />
          <div class="hero-caption">
            <span>JINJU EXPERIENCE CENTER</span>
            <strong>두 센터에서 직접 비교 체험</strong>
          </div>
        </div>
        <div class="hero-photo-label"><span>01</span><strong>남강센터</strong><i></i><span>02</span><strong>진주경상센터</strong></div>
      </div>
    </div>

    <!-- Stats strip -->
    <div class="container-wide stats-strip" aria-label="주요 수치">
      {stats.map((stat) => (
        <div class="stat-item">
          <p class="stat-value">
            {stat.value}<small>{stat.unit}</small>
          </p>
          <p class="stat-label">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── CENTERS ───────────────────────────────────────────── -->
  <section class="section-space center-section">
    <div class="container-wide">
      <SectionHeading kicker="CHOOSE YOUR CENTER" title="가까운 진주센터를 선택하세요" description="남강센터와 진주경상센터의 위치를 확인하고 방문 전에 전화·문자 또는 네이버 플레이스로 문의해 주세요." />
      <div class="center-grid">
        {centers.map((center) => <CenterCard center={center} />)}
      </div>
      <div class="center-cta">
        <a class="button-primary" href={phoneHref(site.representativePhone)} data-track-event="phone_click">
          <Icon name="phone" size={18} /> 지금 전화로 문의하기
        </a>
        <a class="button-ghost" href={smsHref(site.representativeSms, site.defaultSmsBody)} data-track-event="sms_click">
          <Icon name="message" size={18} /> 문자로 문의
        </a>
      </div>
    </div>
  </section>

  <!-- ── WHY EXPERIENCE ────────────────────────────────────── -->
  <section class="section-space experience-section">
    <div class="container-wide">
      <div class="experience-header">
        <div class="experience-intro">
          <p class="section-kicker">WHY EXPERIENCE MATTERS</p>
          <h2 class="section-title">구매 전에 직접<br />누워보고 비교하세요</h2>
          <p class="experience-desc">제품의 크기와 형태, 지압감, 온열감, 프레임과 설치 공간에 따라 체감이 달라질 수 있습니다. 온라인 정보만으로 결정하기보다 실제 사용하실 분이 충분히 비교해 보세요.</p>
          <p class="experience-note">무료체험 후 바로 구매하지 않으셔도 됩니다.</p>
        </div>
        <a class="button-primary experience-reserve" href={withBase('/experience/')} data-track-event="reservation_click">
          무료체험 예약하기 <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="experience-features">
        {experienceFeatures.map((feature) => (
          <div class="feature-card">
            <span class="feature-icon"><Icon name={feature.icon} size={20} strokeWidth={1.8} /></span>
            <span class="feature-text">{feature.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TECHNOLOGY ────────────────────────────────────────── -->
  <section class="section-space technology-section">
    <div class="container-wide">
      <SectionHeading kicker="3H TECHNOLOGY" title="공식 기술과 인증 범위까지, 정확하게 안내합니다" description="본사 공식 자료와 제공된 인증 자료의 범위 안에서 지압·온열 기술과 의료기기 관련 정보를 구분해 설명합니다." />
      <div class="technology-grid">
        <article>
          <span class="tech-stat">62</span>
          <Icon name="hand" size={32} />
          <h3>황동 지압봉</h3>
          <p>62개의 황동 지압봉 구조와 작동 방식은 본사 공식 설명을 기준으로 안내합니다.</p>
        </article>
        <article>
          <span class="tech-stat">70℃</span>
          <Icon name="heat" size={32} />
          <h3>최고 온열 온도</h3>
          <p>최고 70도 온열 기능과 온도 조절, 사용 방법 및 주의사항을 함께 확인하세요.</p>
        </article>
        <article>
          <span class="tech-stat">02</span>
          <Icon name="shield" size={32} />
          <h3>허가와 품목 인증</h3>
          <p>제조업 허가와 특정 품목·모델에 적용되는 인증을 서로 다른 근거로 구분합니다.</p>
        </article>
      </div>
      <div class="technology-link"><a class="button-ghost" href={withBase('/technology/')}>기술과 의료기기 정보 자세히 보기 <Icon name="arrow" size={18} /></a></div>
    </div>
  </section>

  <!-- ── PRODUCTS ──────────────────────────────────────────── -->
  <section class="section-space product-section">
    <div class="container-wide">
      <div class="heading-row">
        <SectionHeading kicker="PRODUCT LINE" title="45개 공식 제품 중 주요 라인업을 만나보세요" />
        <a href={withBase('/products/')}>전체 제품 보기 <Icon name="arrow" size={18} /></a>
      </div>
      <div class="product-grid">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
      <p class="data-note">제품명·모델·가격·사진은 {productCatalog.checkedAt} 3H 공식 제품 카탈로그 기준입니다. 센터별 체험 모델과 입고 일정은 무료체험 예약 시 안내합니다.</p>
    </div>
  </section>

  <!-- ── MID-PAGE CTA ──────────────────────────────────────── -->
  <section class="mid-cta-section">
    <div class="container-wide mid-cta-inner">
      <p class="mid-cta-label">궁금한 점이 있으신가요?</p>
      <h2 class="mid-cta-title">직접 방문하기 전에 전화로 먼저 문의해 보세요</h2>
      <div class="mid-cta-actions">
        <a class="button-primary" href={phoneHref(site.representativePhone)} data-track-event="phone_click">
          <Icon name="phone" size={19} /> {site.representativePhone}
        </a>
        <a class="button-ghost mid-cta-ghost" href={smsHref(site.representativeSms, site.defaultSmsBody)} data-track-event="sms_click">
          <Icon name="message" size={19} /> 문자로 문의
        </a>
      </div>
    </div>
  </section>

  <!-- ── VIDEOS ────────────────────────────────────────────── -->
  <section class="section-space video-section">
    <div class="container-wide video-grid">
      <SectionHeading kicker="OFFICIAL FILM" title="영상으로 먼저 살펴보는 3H" description="썸네일을 누를 때만 외부 영상을 불러와 초기 로딩을 가볍게 유지합니다." />
      <div class="videos">
        <VideoEmbed title="3H 브랜드 영상" description="본사 공식 영상 보기" videoId="E1_MOJj9svo" thumbnail="/images/video/brand-film.webp" />
        <VideoEmbed title="3H 기술 영상" description="지압 기술 원리 보기" videoId="uDev_9Bwb_Y" thumbnail="/images/video/technology-film.webp" />
      </div>
    </div>
  </section>

  <!-- ── CERTIFICATIONS ────────────────────────────────────── -->
  <section class="section-space certification-section">
    <div class="container-wide">
      <SectionHeading kicker="CERTIFICATION SCOPE" title="공식 인증과 기술로 확인하는 3H" description="제조사의 의료기기 제조업 허가와 특정 품목·모델의 인증을 한 문장으로 묶지 않고 적용 범위를 분명히 표시합니다." />
      <div class="certifications">
        {publishedCertifications.map((certification) => <CertificationCard certification={certification} />)}
      </div>
      <a class="button-ghost" href={withBase('/certifications/')}>인증·허가 자료 전체 보기 <Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <!-- ── VISITOR PROFILES ──────────────────────────────────── -->
  <section class="section-space profiles-section">
    <div class="container-wide">
      <SectionHeading kicker="WHO VISITS" title="이런 분들이 많이 체험하러 오십니다" description="두 센터의 실제 방문 후기는 네이버 플레이스 원문 링크에서 확인할 수 있습니다." />
      <div class="profiles-grid">
        {visitorProfiles.map((profile, index) => (
          <div class="profile-card">
            <span class="profile-num">{String(index + 1).padStart(2, '0')}</span>
            <p class="profile-text">{profile}</p>
            <div class="profile-accent" aria-hidden="true"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── EXPERIENCE FLOW ───────────────────────────────────── -->
  <section class="section-space flow-section">
    <div class="container-wide">
      <SectionHeading kicker="EXPERIENCE FLOW" title="무료체험은 이렇게 진행됩니다" description="방문 인원과 체험 제품에 따라 소요 시간은 달라질 수 있습니다." />
      <ExperienceSteps />
      <div class="flow-contact">
        <a class="button-primary" href={phoneHref(site.representativePhone)} data-track-event="phone_click">
          <Icon name="phone" size={19} /> 방문 시간 문의하기
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────── -->
  <section class="section-space faq-section">
    <div class="container-wide faq-grid">
      <SectionHeading kicker="FAQ" title="방문 전에 많이 묻는 질문" description="확정된 답변만 공개합니다. 제품별 사양과 센터 운영 정보는 방문 전에 다시 확인해 주세요." />
      <div>
        <FaqList faqs={publishedFaqs.slice(0, 6)} />
        <a class="faq-more" href={withBase('/faq/')}>전체 질문 보기 <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <FinalCta />
</BaseLayout>

<style>
  /* ── HERO ──────────────────────────────────────────── */
  .home-hero {
    overflow: hidden;
    padding: clamp(2.5rem, 5vw, 5rem) 0 0;
    background: #fcfaf5;
  }

  .hero-grid {
    display: grid;
    width: min(100% - clamp(2rem, 5vw, 6rem), 92rem);
    grid-template-columns: minmax(27rem, .9fr) minmax(38rem, 1.1fr);
    align-items: center;
    gap: clamp(2.5rem, 4vw, 4.5rem);
  }

  .hero-copy {
    max-width: 39rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 1.5rem;
    padding: 0.35rem 0.75rem;
    background: #eef4f0;
    border: 1px solid #c5d8cb;
    border-radius: 2rem;
    color: #174b35;
    font-size: 0.74rem;
    font-weight: 750;
    letter-spacing: 0.01em;
  }

  .hero-badge :global(svg) {
    color: #8f6835;
    flex-shrink: 0;
  }

  .display-title em {
    color: #174b35;
    font-style: normal;
  }

  .hero-copy .display-title {
    font-size: clamp(3rem, 4.5vw, 4.8rem);
  }

  .hero-copy .lead-copy {
    max-width: 35rem;
    margin: 1.75rem 0 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .hero-cta-primary {
    padding: 0.9rem 1.5rem;
    font-size: 1.05rem;
  }

  .hero-sub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.15rem;
    color: #5b625f;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
    text-decoration-color: rgba(91,98,95,.35);
  }

  .hero-sub-link:hover {
    color: #174b35;
    text-decoration-color: #174b35;
  }

  .hero-visual {
    position: relative;
    height: clamp(31rem, 36vw, 41rem);
  }

  .hero-frame {
    position: absolute;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #eee3d1;
    box-shadow: 0 1.5rem 4rem rgba(30, 38, 34, .16);
  }

  .hero-frame-brand {
    z-index: 1;
    top: 0;
    left: 0;
    width: 78%;
  }

  .hero-frame-showroom {
    z-index: 2;
    right: 0;
    bottom: 0;
    width: 68%;
    border: .55rem solid #fcfaf5;
  }

  .hero-product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-caption {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    padding: 3.5rem 1.25rem 1.15rem;
    background: linear-gradient(transparent, rgba(11,45,34,.88));
    color: white;
  }

  .hero-caption span {
    color: #d4b47c;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .hero-caption strong {
    font-size: 1.2rem;
  }

  .hero-photo-label {
    position: absolute;
    z-index: 3;
    bottom: 1rem;
    left: 0;
    display: grid;
    grid-template-columns: auto auto 2rem auto auto;
    align-items: center;
    gap: .5rem;
    padding: .75rem .9rem;
    background: #174b35;
    color: white;
    font-size: .72rem;
  }

  .hero-photo-label span {
    color: #d4b47c;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .hero-photo-label i {
    height: 1px;
    background: rgba(255,255,255,.35);
  }

  /* ── STATS STRIP ───────────────────────────────────── */
  .stats-strip {
    display: grid;
    width: min(100% - clamp(2rem, 5vw, 6rem), 92rem);
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(2.5rem, 6vw, 5rem);
    border-top: 1px solid #d5d8d5;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 1.5rem;
    border-right: 1px solid #d5d8d5;
    border-bottom: 1px solid #d5d8d5;
  }

  .stat-item:last-child {
    border-right: 0;
  }

  .stat-value {
    margin: 0 0 0.25rem;
    color: #174b35;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .stat-value small {
    font-size: 0.55em;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-left: 0.1em;
  }

  .stat-label {
    margin: 0;
    color: #5b625f;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  /* ── CENTERS ───────────────────────────────────────── */
  .center-section {
    background: #f0f1ef;
  }

  .center-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .center-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  /* ── EXPERIENCE ────────────────────────────────────── */
  .experience-section {
    background: #123d2d;
    color: white;
  }

  .experience-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .experience-intro .section-kicker {
    color: #d4b47c;
  }

  .experience-desc {
    margin: 1.5rem 0 0;
    color: #dce9e1;
    max-width: 42rem;
  }

  .experience-note {
    margin: 1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,.2);
    color: #e2c796;
    font-weight: 700;
  }

  .experience-reserve {
    flex-shrink: 0;
    margin-top: 0.5rem;
    background: #d4b47c;
    color: #0b2d22;
    border-color: #d4b47c;
    font-weight: 800;
