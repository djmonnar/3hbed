---
import { withBase } from '@/lib/paths';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  videoId: string;
  thumbnail: string;
}

const { title, description, videoId, thumbnail } = Astro.props;
---

<div class="video-card" data-video-card data-video-id={videoId}>
  <button type="button" data-video-load data-track-event="video_play" aria-label={`${title} 영상 재생`}>
    <img src={withBase(thumbnail)} width="480" height="360" alt="" loading="lazy" decoding="async" />
    <span class="video-overlay">
      <span class="play"><Icon name="arrow" size={25} /></span>
      <span><strong>{title}</strong><small>{description}</small></span>
    </span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-card]').forEach((card) => {
    const button = card.querySelector<HTMLButtonElement>('[data-video-load]');
    button?.addEventListener('click', () => {
      const id = card.dataset.videoId;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
      iframe.title = button.getAttribute('aria-label') || '3H 영상';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      card.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video-card {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #171a19;
  }

  button,
  .video-card :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  button {
    position: relative;
    display: block;
    padding: 0;
    cursor: pointer;
    background: #171a19;
    color: white;
  }

  button > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.76;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    padding: clamp(1.25rem, 4vw, 2.25rem);
    background: linear-gradient(transparent 30%, rgba(11,45,34,.9));
    text-align: left;
  }

  .play {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(255,255,255,.65);
    border-radius: 50%;
    background: white;
    color: #174b35;
  }

  .play :global(svg) {
    transform: translateX(1px);
  }

  .video-overlay > span:last-child {
    display: grid;
  }

  strong {
    font-size: clamp(1rem, 2.2vw, 1.5rem);
  }

  small {
    color: #dce9e1;
  }
</style>
