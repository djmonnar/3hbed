  check: ['m5 12 4 4L19 6'],
  clock: ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z', 'M12 6v6l4 2'],
  close: ['M6 6l12 12', 'M18 6 6 18'],
  external: ['M15 3h6v6', 'M10 14 21 3', 'M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6'],
  hand: ['M8 11V6a2 2 0 0 1 4 0v4', 'M12 10V5a2 2 0 0 1 4 0v6', 'M16 11V7a2 2 0 0 1 4 0v8c0 4-3 7-7 7h-1c-3 0-5-1-7-4l-3-5a2 2 0 0 1 3-3l3 3'],
  heat: ['M12 2c2 3-2 4 0 7s-2 4 0 7', 'M7 5c2 2-2 3 0 5s-2 3 0 5', 'M17 5c2 2-2 3 0 5s-2 3 0 5', 'M5 21h14'],
