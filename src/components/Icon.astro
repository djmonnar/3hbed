---
interface Props {
  name:
    | 'arrow'
    | 'bed'
    | 'building'
    | 'check'
    | 'clock'
    | 'close'
    | 'external'
    | 'hand'
    | 'heat'
    | 'map'
    | 'menu'
    | 'message'
