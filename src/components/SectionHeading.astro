---
interface Props {
  kicker: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { kicker, title, description, align = 'left' } = Astro.props;
---

<header class:list={['section-heading', `align-${align}`]}>
  <p class="section-kicker">{kicker}</p>
  <h2 class="section-title">{title}</h2>
  {description && <p>{description}</p>}
</header>

<style>
  .section-heading {
    max-width: 46rem;
  }

  .section-heading > p:last-child {
    margin: 1.25rem 0 0;
    color: #5b625f;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .align-center {
    margin-inline: auto;
    text-align: center;
  }
</style>
