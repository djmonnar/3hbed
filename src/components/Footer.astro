---
import { centers } from '@/data/centers';
import { footerNavigation, navigation } from '@/data/navigation';
import { site } from '@/data/site';
import { withBase } from '@/lib/paths';
---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <img src={withBase('/images/brand/3h-logo-light.png')} width="126" height="52" alt="3H" loading="lazy" />
      <p>{site.officialDealerNotice}</p>
      <small>제품 정보는 공식 자료의 범위 안에서 안내하며, 제품별 사양과 센터 체험 모델은 상담 시 정확하게 안내합니다.</small>
    </div>
    <nav aria-label="하단 주요 메뉴">
      <p>둘러보기</p>
      {navigation.slice(1).map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>
    <nav aria-label="하단 보조 메뉴">
      <p>안내</p>
      {footerNavigation.map((item) => {
        const external = 'external' in item && item.external;
        return (
          <a href={external ? item.href : withBase(item.href)} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
            {item.label}
          </a>
        );
      })}
    </nav>
    <div class="footer-centers">
      <p>진주센터</p>
      {centers.map((center) => (
        <a href={withBase(`/centers/${center.slug}/`)}>
          <strong>{center.shortName}</strong>
          <span>{center.address}</span>
        </a>
      ))}
    </div>
  </div>
  <div class="container-wide footer-bottom">
    <p>© {new Date().getFullYear()} 3H지압침대 진주경상·남강센터.</p>
    <p>제조사 의료기기 제조업 허가 제228호 · 제조사: 주식회사 쓰리에이치</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 4.5rem 0 2rem;
    background: #171a19;
    color: white;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.6fr;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .footer-brand img {
    width: 4.5rem;
    height: auto;
    margin-bottom: 1.5rem;
  }

  .footer-brand p {
    max-width: 25rem;
    margin: 0 0 0.75rem;
    font-weight: 700;
  }

  .footer-brand small {
    display: block;
    max-width: 28rem;
    color: #aeb4b0;
    line-height: 1.7;
  }

  .footer-grid nav,
  .footer-centers {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }

  .footer-grid nav > p,
  .footer-centers > p {
    margin: 0 0 0.8rem;
    color: #b78d53;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .footer-grid nav a {
    color: #d8dbd9;
    font-size: 0.9rem;
  }

  .footer-grid nav a:hover {
    color: white;
  }

  .footer-centers a {
    display: grid;
    padding-block: 0.55rem;
    border-bottom: 1px solid #353938;
  }

  .footer-centers strong {
    font-size: 0.9rem;
  }

  .footer-centers span {
    color: #aeb4b0;
    font-size: 0.78rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid #353938;
    color: #959d98;
    font-size: 0.75rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr;
    }

    .footer-centers {
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-centers > p {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .site-footer {
      padding-top: 3.5rem;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand,
    .footer-centers {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      display: grid;
      margin-top: 3rem;
    }
  }
</style>
