---
import type { Product } from '@/data/types';
import { withBase } from '@/lib/paths';
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="product-card">
  <a class="product-image-link" href={withBase(`/products/${product.slug}/`)} data-track-event="product_view" data-product={product.slug}>
    <ResponsiveImage image={product.mainImage} class="product-image" sizes="(max-width: 720px) 100vw, 33vw" />
  </a>
  <div class="product-meta">
    <p>{product.officialCategory}{product.officialModel && ` · ${product.officialModel}`}</p>
    <h3><a href={withBase(`/products/${product.slug}/`)}>{product.name}</a></h3>
    <p class="price">{product.officialPriceText ?? '공식 홈페이지 가격 미표기'}</p>
    <div class="tags">{product.categories.slice(0, 4).map((category) => <span>{category}</span>)}</div>
    <a class="detail-link" href={withBase(`/products/${product.slug}/`)} data-track-event="product_view" data-product={product.slug}>
      제품 정보 보기 <Icon name="arrow" size={18} />
    </a>
  </div>
</article>

<style>
  .product-card {
    min-width: 0;
  }

  .product-image-link {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid #e1e3e0;
    background: white;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 300ms ease;
  }

  .product-image-link:hover .product-image {
    transform: scale(1.025);
  }

  .product-meta {
    padding: 1.35rem 0 0;
  }

  .product-meta > p:first-child {
    margin: 0 0 0.4rem;
    color: #8f6835;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2.3vw, 1.8rem);
    letter-spacing: -0.04em;
  }

  .price {
    margin: .65rem 0 1rem;
    color: #174b35;
    font-size: 1rem;
    font-weight: 800;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tags span {
    padding: 0.28rem 0.55rem;
    background: #f0f1ef;
    color: #4a514e;
    font-size: 0.72rem;
  }

  .detail-link {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    color: #174b35;
    font-size: 0.88rem;
    font-weight: 800;
  }
</style>
