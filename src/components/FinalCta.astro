---
import { centers } from '@/data/centers';
import { site } from '@/data/site';
import { phoneHref, smsHref } from '@/lib/paths';
import Icon from './Icon.astro';
---

<section class="final-cta">
  <div class="container-wide final-grid">
    <div>
      <p class="section-kicker">FREE EXPERIENCE</p>
      <h2>사진으로만 보지 말고<br />가까운 진주센터에서 직접 체험해보세요</h2>
    </div>
    <div>
      <p>다양한 3H지압침대와 지압쇼파를 직접 비교하고 제품과 설치 공간에 관한 상담을 받아보실 수 있습니다.</p>
      <div class="cta-actions">
        <a class="button-primary" href={phoneHref(site.representativePhone)} data-track-event="phone_click">
          <Icon name="phone" size={20} /> 전화로 무료체험 예약
        </a>
        <a class="button-secondary" href={smsHref(site.representativeSms, site.defaultSmsBody)} data-track-event="sms_click">
          <Icon name="message" size={20} /> 문자로 문의
        </a>
        {centers.map((center) => (
          <a class="button-ghost" href={center.naverPlaceUrl} target="_blank" rel="noopener noreferrer" data-track-event="place_click" data-center={center.id}>
            {center.shortName} 길찾기
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-block: clamp(4rem, 9vw, 8rem);
    background: #eee3d1;
  }

  .final-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
    gap: clamp(2rem, 8vw, 8rem);
  }

  h2 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 4rem);
    line-height: 1.2;
    letter-spacing: -0.05em;
  }

  .final-grid > div:last-child > p {
    margin: 0 0 1.5rem;
    color: #5c5448;
    font-size: 1.05rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  @media (max-width: 850px) {
    .final-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .cta-actions {
      display: grid;
    }
  }
</style>
