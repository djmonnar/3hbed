---
const steps = [
  '전화·문자·네이버 플레이스로 방문 문의',
  '가까운 센터와 희망 방문 시간 선택',
  '센터에서 다양한 제품 직접 체험',
  '제품 크기와 설치 공간 상담',
  '제품별 기능과 사용 방법 안내',
  '희망하는 경우 구매·렌탈·설치 상담',
];
---

<ol class="experience-steps">
  {steps.map((step, index) => (
    <li>
      <span>{String(index + 1).padStart(2, '0')}</span>
      <p>{step}</p>
    </li>
  ))}
</ol>

<style>
  .experience-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid #9ba29e;
    list-style: none;
  }

  li {
    min-height: 11rem;
    padding: 1.5rem;
    border-right: 1px solid #d5d8d5;
    border-bottom: 1px solid #d5d8d5;
  }

  li:nth-child(3n) {
    border-right: 0;
  }

  span {
    color: #8f6835;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  p {
    max-width: 15rem;
    margin: 2.5rem 0 0;
    font-size: 1.06rem;
    font-weight: 720;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .experience-steps {
      grid-template-columns: repeat(2, 1fr);
    }

    li:nth-child(3n) {
      border-right: 1px solid #d5d8d5;
    }

    li:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (max-width: 480px) {
    .experience-steps {
      grid-template-columns: 1fr;
    }

    li,
    li:nth-child(3n),
    li:nth-child(2n) {
      min-height: auto;
      border-right: 0;
    }

    p {
      margin-top: 1rem;
    }
  }
</style>
