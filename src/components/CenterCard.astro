---
import type { Center } from '@/data/types';
import { site } from '@/data/site';
import { phoneHref, smsHref, withBase } from '@/lib/paths';
import Icon from './Icon.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  center: Center;
  headingLevel?: 'h2' | 'h3';
}

const { center, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const contactPhone = center.phone ?? site.representativePhone;
const contactSms = center.sms ?? site.representativeSms;
---

<article class="center-card">
  <div class="center-media">
    {center.heroImage ? (
      <ResponsiveImage image={center.heroImage} class="center-image" sizes="(max-width: 900px) 100vw, 50vw" />
    ) : (
      <PhotoPlaceholder label={`${center.shortName} 대표 사진`} todo={`TODO: ${center.shortName} 대표 사진 필요`} />
    )}
  </div>
  <div class="center-content">
    <p class="center-label">JINJU EXPERIENCE CENTER</p>
    <Heading>{center.name}</Heading>
    <dl>
      <div>
        <dt>주소</dt>
        <dd>{center.address ?? '네이버 플레이스에서 위치를 확인해 주세요.'}</dd>
      </div>
      <div>
        <dt>무료체험</dt>
        <dd>{center.freeExperience ? '방문 전 문의 권장' : '확인 필요'}</dd>
      </div>
      <div>
        <dt>운영·주차</dt>
        <dd>{center.openingHours ?? '방문 전 센터에 확인해 주세요.'}</dd>
      </div>
    </dl>
    <div class="center-actions">
      <a href={withBase(`/centers/${center.slug}/`)} data-track-event="center_select" data-center={center.id}>
        센터 상세 <Icon name="arrow" size={18} />
      </a>
      <a href={center.naverPlaceUrl} target="_blank" rel="noopener noreferrer" data-track-event="place_click" data-center={center.id}>
        네이버 길찾기 <Icon name="external" size={17} />
      </a>
      <a href={phoneHref(contactPhone)} data-track-event="phone_click" data-center={center.id}>전화</a>
      <a href={smsHref(contactSms, `${center.shortName} 무료체험 문의드립니다.`)} data-track-event="sms_click" data-center={center.id}>문자</a>
    </div>
  </div>
</article>

<style>
  .center-card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-top: 3px solid #174b35;
    background: white;
  }

  .center-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .center-media :global(.photo-placeholder) {
    height: 100%;
  }

  .center-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .center-content {
    padding: clamp(1.4rem, 4vw, 2.5rem);
    border: 1px solid #e1e3e0;
    border-top: 0;
  }

  .center-label {
    margin: 0 0 0.55rem;
    color: #8f6835;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  h2,
  h3 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    line-height: 1.3;
    letter-spacing: -0.04em;
  }

  dl {
    display: grid;
    gap: 0;
    margin: 1.5rem 0;
  }

  dl > div {
    display: grid;
    grid-template-columns: 5.4rem 1fr;
    gap: 0.75rem;
    padding-block: 0.65rem;
    border-top: 1px solid #e1e3e0;
  }

  dt {
    color: #707773;
    font-size: 0.84rem;
  }

  dd {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 620;
  }

  .center-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .center-actions a {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid #b9bfbb;
    font-size: 0.82rem;
    font-weight: 750;
  }

  .center-actions a:first-child {
    border-color: #174b35;
    background: #174b35;
    color: white;
  }
</style>
